# ArchLens
#
# Copy this file to `.env` in the repository root. The Python skill reads both
# process env vars and this file.

# Default text model provider: gemini | openai-compat | mock
ARCHLENS_PROVIDER=mock

# Default image provider: gemini | openai-compat | local-svg
ARCHLENS_IMAGE_PROVIDER=local-svg

# Output language used by default prompt packs
ARCHLENS_LANGUAGE=中文

# Root directories
ARCHLENS_ARTIFACTS_DIR=artifacts
ARCHLENS_STATE_DIR=.agent-state
ARCHLENS_SOURCE_DOCS_DIR=source-docs
ARCHLENS_READING_NOTES_DIR=reading-notes

# Optional reference manager MCP.
# Local reading does not need this. Set it when you want MCP-backed library input.
ARCHLENS_REFERENCE_MCP_COMMAND=
ARCHLENS_REFERENCE_MCP_ARGS=
ARCHLENS_NOTE_TITLE_PREFIX=ArchLens

# MinerU
# Optional for local `.md` / `.txt` reading. For local PDF reading, either
# configure MinerU or install a local extractor such as `pdftotext` / `pypdf`.
MINERU_API_URL=https://mineru.net
MINERU_API_KEY=
MINERU_POLL_INTERVAL_MS=5000
MINERU_TIMEOUT_MS=300000

# Gemini
GEMINI_API_URL=https://generativelanguage.googleapis.com
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-pro
GEMINI_IMAGE_MODEL=gemini-2.0-flash-preview-image-generation

# OpenAI-compatible text / image endpoint
OPENAI_COMPAT_API_URL=
OPENAI_COMPAT_API_KEY=
OPENAI_COMPAT_MODEL=gpt-4.1
OPENAI_COMPAT_IMAGE_MODEL=gpt-image-1

# Optional image prompt styling. Image config is not required for deep reading.
IMAGE_CANVAS_WIDTH=1600
IMAGE_CANVAS_HEIGHT=900
